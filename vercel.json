{
  "rewrites": [
    {
      "source": "/",
      "destination": "https://mi-plataforma-fiscal.vercel.app/analisis-xml"
    },
    {
      "source": "/analisis-xml/:path*",
      "destination": "https://mi-plataforma-fiscal.vercel.app/:path*"
    },
    {
      "source": "/auditor/:path*",
      "destination": "https://analizador-de-xml.vercel.app/:path*"
    },
    {
      "source": "/estimador/:path*",
      "destination": "https://estimador-de-impuestos.vercel.app/:path*"
    },
    {
      "source": "/extractor-nomina/:path*",
      "destination": "https://extractor-nomina-cfdi.vercel.app/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://mi-plataforma-fiscal.vercel.app/_next/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://mi-plataforma-fiscal.vercel.app/static/:path*"
    },
    {
      "source": "/:path*",
      "destination": "https://mi-plataforma-fiscal.vercel.app/:path*"
    }
  ]
}
